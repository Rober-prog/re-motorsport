# Only public configuration may use the VITE_ prefix.
VITE_CONTACT_ENABLED=false
# Copy server secrets to .dev.vars for local Wrangler. Set them in Cloudflare for production.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
ALLOWED_ORIGIN=https://rmartorell.com
# Server secret for daily rotating, salted rate limit keys (random >=32 chars).
RATE_LIMIT_SALT=
# Bind CONTACT_RATE_DB to D1 and apply migrations/0001_contact_rate.sql.
# No messages or contact details are stored in D1. Missing setup returns 503.
